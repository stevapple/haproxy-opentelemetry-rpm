# Single source of truth for every pinned component.
#
# These pins are NOT arbitrary: they are transcribed from the upstream
# haproxytech build tooling and must be changed together.
#
#   filter  -> haproxytech/haproxy-opentelemetry  README "Dependencies"
#   wrapper -> haproxytech/opentelemetry-c-wrapper README "Build Instructions"
#   otelcpp -> opentelemetry-c-wrapper/scripts/build/opentelemetry-cpp-1.28.0-install.sh
#   deps    -> opentelemetry-c-wrapper/scripts/build/opentelemetry-cpp-monorepo.sh
#
# See docs/versioning.md before touching anything here.

# --- HAProxy ------------------------------------------------------------
# SPECS/haproxy-otel.spec is a fork of the Fedora haproxy package, so this
# tracks the version on the Fedora branch named below.  Rocky/RHEL 10 ships
# 3.0.5, which CANNOT host the filter (see README.md); 3.4.x is the lowest
# series that builds, and is also what Fedora and RHEL 11 ship.
HAPROXY_VERSION=3.4.3
HAPROXY_RPM_RELEASE=1

# Fedora dist-git revision the spec is forked from.  Bump together with
# HAPROXY_VERSION when rebasing onto a newer Fedora haproxy, and re-apply the
# hunks marked "OTel delta:" in the spec.
FEDORA_HAPROXY_BRANCH=rawhide
FEDORA_HAPROXY_COMMIT=11852b3685f34562a7302bfa46baa4df66c29967

# Version Rocky/RHEL 10.x actually ships, recorded so CI can detect a rebase.
DISTRO_HAPROXY_VERSION=3.0.5

# --- HAProxy OTel filter ------------------------------------------------
OTEL_FILTER_VERSION=2.2.0

# --- OpenTelemetry C wrapper --------------------------------------------
OTEL_WRAPPER_VERSION=3.3.0

# --- OpenTelemetry C++ SDK ----------------------------------------------
# Pinned exactly: the wrapper's patch set applies to this release only.
OTELCPP_VERSION=1.28.0

# --- Vendored third-party sources (opentelemetry-cpp-monorepo.sh pins) ---
ABSEIL_TAG=20250512.1
PROTOBUF_TAG=v35.1
GRPC_TAG=v1.82.1
RYML_TAG=v0.15.2
CURL_TAG=curl-8_21_0
ZLIB_TAG=v1.3.2
NLOHMANN_JSON_TAG=v3.12.0
OTEL_PROTO_TAG=v1.10.0
MS_GSL_TAG=v4.2.1
PROMETHEUS_CPP_TAG=v1.3.0
OPENTRACING_CPP_TAG=v1.6.0
GOOGLETEST_TAG=v1.17.0
BENCHMARK_TAG=v1.9.4

# --- Target distribution ------------------------------------------------
DIST_TAG=el10
UBI_IMAGE=registry.access.redhat.com/ubi10/ubi:latest
